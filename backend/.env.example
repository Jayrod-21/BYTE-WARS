# BYTE WARS — Backend environment variables
# Copy this file to `.env` and fill in real values for local dev.
# In production (BW_ENV=production), the marked variables are REQUIRED;
# the backend will refuse to start without them.

# ─── Runtime ─────────────────────────────────────────────────────────────────
# "dev"        → tolerant defaults, ephemeral JWT, persisted dev encryption key
# "production" → strict validation, fail fast on any missing secret
# "staging"    → treated like production
BW_ENV=dev

# ─── Auth (REQUIRED in production) ──────────────────────────────────────────
# JWT signing secret. Minimum 32 characters.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# If unset in BW_ENV=dev, the backend issues an ephemeral per-process secret
# and logs a warning. All tokens become invalid on restart.
JWT_SECRET=

# ─── Encryption (REQUIRED in production) ────────────────────────────────────
# Fernet symmetric key used to encrypt champion API keys at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If unset in BW_ENV=dev, the backend persists a key to
# ~/.bytewars_dev_encryption_key (chmod 600) so dev data survives restarts.
ENCRYPTION_KEY=

# ─── Database ───────────────────────────────────────────────────────────────
# Async SQLAlchemy connection string. Local default is sqlite for dev.
# Production uses Postgres, e.g.
#   postgresql+asyncpg://user:pass@host:5432/bytewars
DATABASE_URL=

# ─── Cache / Queue ──────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── CORS ───────────────────────────────────────────────────────────────────
# Comma-separated list of frontend origins allowed to call the API.
# Example for prod: https://bytewars.example.com,https://www.bytewars.example.com
# Leave unset in dev to allow http://localhost:5173 by default.
CORS_ORIGINS=
