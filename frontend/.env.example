# BYTE WARS — Frontend environment variables (Vite)
# Copy this file to `.env.local` and override defaults as needed.
# Vite only exposes vars prefixed with VITE_ to client code.

# ─── API ────────────────────────────────────────────────────────────────────
# When set, the api client targets this absolute base URL.
# When unset, requests go to /api/* (proxied through Vite dev server or
# served from the same origin in production).
# VITE_API_BASE=http://localhost:8000/api
